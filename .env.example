# ===========================================================================
# WIDDX Nexus — Environment Configuration
# ===========================================================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# cp .env.example .env
# ===========================================================================
#
# ⚠️ تنبيه أمني: لا ترفع .env إلى GitHub أبدًا!

# ── مفتاح API للخادم ───────────────────────────────────
# مطلوب لجميع طلبات API. غيّره إلى قيمة قوية وفريدة.
WIDDX_API_KEY="your-super-secret-api-key-change-me"

# ── Provider ────────────────────────────────────────────
# اسم المزود (deepseek, openai, ollama, gguf, opencode-zen)
WIDDX_PROVIDER_NAME="opencode-zen"
# الموديل المستخدم
WIDDX_PROVIDER_MODEL="deepseek-v4-flash-free"
# رابط API (اختياري — للـ OpenAI-compatible providers)
WIDDX_PROVIDER_BASE_URL=""

# ── API Key للمزود ──────────────────────────────────────
# مفتاح API للـ LLM provider
WIDDX_LLM_API_KEY=""

# ── الخادم ──────────────────────────────────────────────
# Host للمخدم (0.0.0.0 للكل، 127.0.0.1 للمحلي فقط)
WIDDX_HOST="127.0.0.1"
# Port
WIDDX_PORT=8000
# الحد الأقصى لحجم الطلب (بالبايت) — 1MB افتراضيًا
WIDDX_MAX_BODY_BYTES=1048576

# ── CORS ────────────────────────────────────────────────
# النطاقات المسموح بها (مفصولة بفواصل)
# في الإنتاج: حدد النطاقات بدقة!
WIDDX_CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# ── قاعدة البيانات ──────────────────────────────────────
# مسار قاعدة بيانات SQLite
WIDDX_DB_PATH="./.widdx/data/widdx.db"

# ── الذاكرة والتخزين المؤقت ─────────────────────────────
# الحد الأقصى لعدد الحقائق في الذاكرة
WIDDX_MAX_MEMORIES=500
# مدة التخزين المؤقت (ثوانٍ)
WIDDX_CACHE_TTL=300

# ── Rate Limiting ───────────────────────────────────────
# الحد الأقصى لعدد الطلبات في الدقيقة
WIDDX_RATE_LIMIT_MAX=60
# نافذة الـ Rate Limiting (ثوانٍ)
WIDDX_RATE_LIMIT_WINDOW=60

# ── المراقبة (Monitoring) ──────────────────────────────
# تفعيل نظام المراقبة
WIDDX_MONITORING_ENABLED=true
# إرسال الـ metrics إلى Prometheus
WIDDX_PROMETHEUS_ENABLED=false
# رابط Sentry (اختياري)
WIDDX_SENTRY_DSN=""

# ── الـ logging ─────────────────────────────────────────
# مستوى logging (DEBUG, INFO, WARNING, ERROR)
WIDDX_LOG_LEVEL="INFO"
# مسار ملف الـ log (اختياري — stdout إذا كان فارغًا)
WIDDX_LOG_FILE=""

# ── الـ Docker ──────────────────────────────────────────
# مسار مشروع WIDDX داخل الحاوية
WIDDX_HOME="/workspace"

# ── الـ MCP ─────────────────────────────────────────────
# تفعيل MCP servers
WIDDX_MCP_ENABLED=true
# MCP servers (JSON array) — override من config.json
WIDDX_MCP_SERVERS=""
