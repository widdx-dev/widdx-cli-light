/* =============================================================
   WIDDX TUI — Unified Design System Stylesheet
   ============================================================= */

/* ── Design Tokens ──────────────────────── */
$bg:        #0b0f19;
$panel-bg:  #0f172a;
$border:    #1e293b;
$primary:   #6366f1;
$phover:    #818cf8;
$secondary: #0891b2;
$shover:    #06b6d4;
$text:      #e2e8f0;
$muted:     #64748b;
$dim:       #475569;
$accent:    #f5a623;
$err:       #ef4444;

/* Animations are managed via Python in Textual */

Screen { layout: vertical; background: $bg; color: $text; }

/* ── Header Widget ───────────────────────── */
#header {
    height: 4;
    min-height: 4;
    max-height: 4;
    background: $panel-bg;
    border-bottom: solid $primary;
    padding: 0 2;
    align: center middle;
    width: 100%;
}

/* Left section (logo + menu) */
.header-left-section {
    height: 100%;
    width: auto;
    align: center middle;
}

/* Header Button (Grid) */
.header-btn {
    width: 4;
    min-width: 4;
    height: 100%;
    background: transparent;
    color: $accent;
    border: none;
    text-style: bold;
    content-align: center middle;
    padding: 0 1;
    margin: 0 1 0 0;
    transition: background 150ms, color 150ms;
}
.header-btn:hover {
    background: rgba(99, 102, 241, 0.15);
    color: $phover;
}
.header-btn:focus {
    background: rgba(99, 102, 241, 0.25);
    color: $phover;
}

/* Header Logo */
.header-logo {
    color: $primary;
    text-style: bold;
    content-align: left middle;
    padding: 0 1;
    height: 100%;
    width: auto;
}

/* Header Info */
#header-info {
    height: 100%;
    width: 1fr;
    content-align: left middle;
    color: $text;
    padding: 0 2;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

/* Right section (selectors) */
.header-right-section {
    height: 100%;
    width: auto;
    min-width: 50;
    align: center middle;
}

/* Header Selector Label */
.header-selector-label {
    height: 100%;
    width: auto;
    color: $muted;
    content-align: right middle;
    margin-right: 1;
    margin-left: 1;
    padding: 0;
}

/* Header Selector (Dropdown) */
.header-selector {
    width: 20;
    min-width: 35;
    height: 3;
    border: none;
    background: rgba(0, 0, 0, 0.1);
    color: $text;
    padding: 0 0;
    margin: 0 0;
}
.header-selector:hover {
    background: rgba(99, 102, 241, 0.1);
}
.header-selector:focus {
    background: rgba(99, 102, 241, 0.2);
}

/* ── Main Layout ─────────────────────────── */
#processing { 
    height: 1; 
    background: $primary; 
    display: none; 
    color: #0b0f19; 
    text-style: bold; 
    content-align: center middle; 
}
#processing.active { display: block; }
#processing.thinking {
    background: $secondary;
}
/* Enhanced shimmer bar variant for extra polish */
#processing.shimmer {
    background: $primary;
}
#body {
    height: 1fr;
}
#body.sidebar-open #chat-log {
    width: 62%;
    transition: width 0.25s;
}
#body.sidebar-open #view-panel {
    width: 38%;
    display: block;
}
#chat-log {
    height: 1fr;
    width: 1fr;
    background: $bg;
    padding: 1 2;
    border: none;
    transition: width 0.25s;
}
#stream-output {
    height: 1fr;
    background: $bg;
    padding: 1 2;
    border: none;
    color: $text;
    display: none;
    overflow-y: auto;
}
#view-panel {
    height: 1fr;
    width: 0;
    background: $panel-bg;
    display: none;
    padding: 0 1;
    border-left: solid $border;
    overflow: hidden;
    layout: vertical;
    transition: width 0.25s, opacity 0.25s;
    opacity: 0;
}
#view-panel.active {
    display: block;
    opacity: 1;
}
#view-panel #view-title { height: 3; background: $bg; border-bottom: solid $border; color: $accent; text-style: bold; content-align: center middle; margin-bottom: 1; }
#view-panel #view-list { height: 1fr; padding: 0; }
#view-panel #view-back { height: 3; width: 100%; margin-top: 1; background: $panel-bg; border: solid $border; color: $muted; }
#view-panel #view-back:hover { color: $phover; border: solid $primary; }
#view-panel #view-list Button { height: 3; background: $panel-bg; color: $text; border: solid $border; content-align: left middle; padding: 0 2; margin-bottom: 1; }
#view-panel #view-list Button:hover { background: #1e293b; color: $primary; border: solid $primary; }
#view-panel #view-list Button.active { background: #1e1b4b; color: $phover; border: solid $primary; }

/* ── Input & Status ─────────────────────── */
#input-container {
    height: auto;
    min-height: 4;
    background: $panel-bg;
    border-top: solid $primary;
    padding: 0 2;
    align: center middle;
}
#input-container #prompt-label {
    width: 3;
    color: $primary;
    text-style: bold;
    content-align: center middle;
    margin-right: 1;
    height: 100%;
}
#input {
    width: 1fr;
    height: 100%;
    background: rgba(0, 0, 0, 0.1);
    color: $text;
    border: none;
    padding: 0 1;
}
#input:focus {
    background: rgba(0, 0, 0, 0.2);
}
#char-count {
    width: 10;
    content-align: right middle;
    color: $muted;
    padding-right: 1;
    height: 100%;
}
#status {
    height: 2;
    background: $panel-bg;
    border-top: solid $border;
    color: $muted;
    padding: 0 2;
    align: left middle;
}
.doctor-title { margin-bottom: 1; border-bottom: solid $border; padding-bottom: 1; color: $primary; text-style: bold; }
#doctor-running { height: 1; color: $phover; text-style: bold; }

/* =============================================================
   UNIVERSAL MODAL DESIGN SYSTEM
   ============================================================= */

/* All modal screens share this wrapper */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

/* Dialog box — override width per screen via #id */
.dialog-box {
    width: 80%;
    max-width: 84;
    height: auto;
    max-height: 85%;
    background: $panel-bg;
    border: solid $primary;
    padding: 1 2;
}

/* Title bar — every dialog has exactly one */
.dialog-title {
    height: 3;
    content-align: center middle;
    color: $phover;
    text-style: bold;
    background: #0b0f19;
    border-bottom: solid $border;
    margin-bottom: 1;
}

/* Content area (RichLog or ScrollableContainer) */
.dialog-body {
    height: 1fr;
    background: #0b0f19;
    border: solid $border;
    padding: 0 1;
}

/* Scrollable form inside dialogs */
.dialog-form {
    height: 1fr;
}

.dialog-form Label {
    color: $phover;
    margin-top: 1;
    margin-bottom: 0;
    text-style: bold;
}

.dialog-form Input, .dialog-form Select, .dialog-form TextArea {
    margin-bottom: 1;
}

/* Actions bar — every dialog has exactly one at bottom */
.dialog-actions {
    height: 4;
    margin-top: 1;
    align: right middle;
    border-top: solid $border;
    padding-top: 1;
}

.dialog-actions Button {
    margin-left: 1;
    min-width: 16;
    height: 3;
}

/* Subtitle text in dialogs */
.dialog-subtitle {
    height: 1;
    color: $dim;
    padding: 0 0 0 1;
    margin-bottom: 0;
}

/* ── Delete confirmation (red variant) ──── */
.delete-dialog { border: solid $err; }
.delete-title { color: $err; }

/* Delete action bar (centered buttons) */
.dialog-actions-center { height: 4; margin-top: 1; align: center middle; border-top: solid $border; padding-top: 1; }
.dialog-actions-center Button { margin: 0 1; min-width: 16; height: 3; }

/* ── Picker dialog (narrow, for selection lists) ── */
.picker-dialog { width: 60%; max-width: 50; height: auto; max-height: 60%; background: $panel-bg; border: solid $secondary; padding: 1 2; }
.picker-title { height: 3; content-align: center middle; color: $secondary; text-style: bold; border-bottom: solid $border; margin-bottom: 1; }
.picker-list { height: 1fr; padding: 0; }
.pick-btn { height: 3; width: 100%; background: transparent; color: #cbd5e1; border: none; content-align: left middle; padding: 0 2; transition: background 120ms, color 120ms; }
.pick-btn:hover { background: #1e293b; color: $phover; }
.picker-actions { height: 3; margin-top: 1; align: right middle; border-top: solid $border; padding-top: 1; }

/* ── Delete message body ────────────────── */
.delete-msg { padding: 1; text-align: center; }

/* ══════════════════════════════════════════════
   FULL-SCREEN LIST SCREENS (Memory, Sessions)
   ══════════════════════════════════════════════ */

.list-screen { background: #0b0f19; }

/* Title bar */
.list-title {
    height: 3;
    content-align: center middle;
    color: $phover;
    text-style: bold;
    background: $panel-bg;
    border-bottom: solid $border;
    dock: top;
}

/* Status bar below title */
.list-status {
    height: 1;
    color: $dim;
    padding: 0 2;
    dock: top;
}

/* Toolbar with action buttons */
.list-toolbar {
    height: 4;
    background: $panel-bg;
    border-bottom: solid $border;
    padding: 0 1;
    dock: top;
    align: left middle;
}

.list-toolbar Button {
    height: 3;
    margin: 0 1;
    min-width: 14;
}

/* Search input inside toolbar */
.list-search {
    width: 30;
    margin-left: 2;
}

/* Main RichLog content area */
.list-content {
    height: 1fr;
    padding: 1 2;
}

/* Footer help bar */
.list-footer {
    height: 1;
    background: $panel-bg;
    border-top: solid $border;
    dock: bottom;
}

.list-footer-text {
    content-align: center middle;
}

/* ── Override dialog sizes per screen ──── */
#settings-dialog { max-width: 60; }
#help-dialog { max-width: 80; }
#tool-detail-dialog { max-width: 90; }
#text-detail-dialog { max-width: 90; }
#mem-edit-dialog { width: 70%; max-width: 60; max-height: 70%; }
#mem-delete-dialog { width: 50%; max-width: 45; }
#mem-picker-dialog { max-width: 50; }
#sess-picker-dialog { max-width: 55; }
#sess-rename-dialog { width: 60%; max-width: 55; }
#sess-delete-dialog { width: 50%; max-width: 45; }

#mem-edit-content {
    height: 8;
    border: solid $border;
}
#mem-edit-content:focus {
    border: solid $primary;
}

/* ── Settings specific ──────────────────── */

/* Full-screen settings (not modal anymore) */
#settings-header {
    height: 3;
    content-align: left middle;
    color: $phover;
    text-style: bold;
    background: $panel-bg;
    border-bottom: solid $border;
    dock: top;
    padding: 0 2;
}

#settings-body {
    height: 1fr;
    padding: 1 2;
    background: $bg;
}

#settings-footer {
    height: 4;
    background: $panel-bg;
    border-top: solid $primary;
    dock: bottom;
    align: right middle;
    padding: 0 2;
}

#settings-footer Button {
    margin-left: 1;
    min-width: 16;
    height: 3;
}

#settings-footer #footer-path {
    color: $dim;
    text-style: italic;
    width: 1fr;
    content-align: left middle;
}

/* ── Settings — Active provider row ────── */
#active-prov-row {
    height: 4;
    background: $panel-bg;
    border-bottom: solid $border;
    dock: top;
    align: left middle;
    padding: 0 2;
}
#active-prov-label {
    width: 18;
    color: $muted;
    text-style: bold;
    content-align: left middle;
}
#active-prov-row Select { width: 20; }
#active-badge {
    width: 1fr;
    content-align: left middle;
    padding-left: 2;
    color: $dim;
}

/* ── Settings — Tabs ────────────────────── */
#settings-tabs {
    height: 1fr;
}

TabbedContent ContentSwitcher { height: 1fr; }
TabbedContent TabPane { height: 1fr; overflow-y: auto; padding: 1 2; }

/* ── Provider Tab fields ─────────────────── */
.prov-desc {
    height: 2;
    color: $dim;
    margin-bottom: 1;
    content-align: left middle;
}

.field-label {
    color: $secondary;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
    height: 1;
}

.field-hint {
    color: $dim;
    text-style: italic;
    height: 1;
    margin-bottom: 0;
}

.field-hint-inline {
    color: $dim;
    text-style: italic;
    content-align: left middle;
    width: 1fr;
    padding-left: 2;
}

.field-row {
    height: 3;
    align: left middle;
    margin-bottom: 0;
}

.field-select { width: 1fr; }
.field-input  { width: 1fr; }

.btn-icon {
    width: 4;
    min-width: 4;
    margin-left: 1;
    background: $panel-bg;
    border: solid $border;
    color: $accent;
    content-align: center middle;
}
.btn-icon:hover { background: $border; color: $phover; }

.btn-sm {
    min-width: 10;
    height: 3;
    margin-left: 1;
    background: $panel-bg;
    border: solid $border;
}
.btn-sm:hover { background: $border; color: $phover; }
.btn-danger { border: solid $err; color: $err; }
.btn-danger:hover { background: $err; color: $text; }

/* Thinking / Reasoning switch */
Switch {
    margin-bottom: 1;
}
Switch > .switch--slider {
    background: $border;
}
Switch.-on > .switch--slider {
    background: $primary;
}

/* ── Rename specific ────────────────────── */
.rename-old { color: $dim; padding: 0 1; margin-bottom: 1; }

/* =============================================================
   GLOBAL WIDGET STYLES
   ============================================================= */

Button {
    background: transparent; border: none; padding: 0 2; color: #cbd5e1;
    transition: background 120ms, color 120ms;
}
Button:hover {
    color: $phover;
}
Button:focus {
    background: $phover;
}
Button.primary { background: $primary; color: #0b0f19; text-style: bold; }
Button.primary:hover { background: $phover; }
Button.error { background: #b91c1c; color: $text; text-style: bold; }
Button.error:hover { background: $err; }

Input { border: solid $border; background: #0b0f19; color: $text; }
Input:focus { border: solid $primary; }

Select { background: #0b0f19; color: $text; border: solid $border; }
Select:focus { border: solid $primary; }

TextArea { background: #0b0f19; color: $text; border: solid $border; }
TextArea:focus { border: solid $primary; }

/* ── Toast notification ──────────────────── */
#toast {
    dock: bottom;
    height: 1;
    content-align: center middle;
    color: $text;
    background: #1e1b4b;
    border-top: solid $primary;
    text-style: bold;
    transition: opacity 0.3s;
}
.toast-hidden {
    display: none;
    opacity: 0;
}
.toast-visible {
    display: block;
    opacity: 1;
}
.toast-fade-out {
}

Scrollbar { width: 1; background: transparent; }
Scrollbar > .scrollbar--track { background: transparent; }
Scrollbar > .scrollbar--slider { background: #1e293b; }
Scrollbar > .scrollbar--slider:hover { background: $primary; }

/* ── Help Quick Actions Grid ── */
#help-quick-row {
    height: auto;
    layout: grid;
    grid-size: 5;
    grid-gutter: 1;
    margin-bottom: 1;
    padding: 0 1;
}
.help-qa-btn {
    height: 3;
    background: $panel-bg;
    border: solid $border;
    color: $text;
    content-align: center middle;
    transition: background 120ms, color 120ms, border 120ms;
}
.help-qa-btn:hover {
    background: $border;
    color: $phover;
    border: solid $primary;
}

/* ── Split Sessions Screen ── */
#sess-container {
    height: 1fr;
    background: $bg;
}
#sess-sidebar {
    width: 38;
    height: 100%;
    background: $panel-bg;
    border-right: solid $border;
    padding: 1 1;
}
#sess-preview {
    height: 100%;
    background: $bg;
    padding: 1 2;
}
.sess-btn {
    height: 4;
    width: 100%;
    background: transparent;
    border: solid $border;
    margin-bottom: 1;
    content-align: left middle;
    padding: 0 1;
    transition: background 120ms, color 120ms, border 120ms;
}
.sess-btn:hover {
    background: #1e293b;
    border: solid $primary;
    color: $phover;
}
.sess-btn:focus, .sess-btn.active {
    background: #1e1b4b;
    border: solid $primary;
    color: $phover;
    text-style: bold;
}


/* ── Ubuntu Grid (App Launcher) ── */
UbuntuGrid {
    background: rgba(11, 15, 25, 1);
    layout: vertical;
    align: center top;
    padding: 1 1;
}

#grid-title {
    width: 70%;
    max-width: 60;
    height: 3;
    min-height: 3;
    max-height: 3;
    background: $panel-bg;
    border: round $primary;
    content-align: center middle;
    margin-bottom: 1;
    padding: 0 2;
}

#grid-search-hint {
    width: 100%;
    height: 1;
    min-height: 1;
    max-height: 1;
    color: $dim;
    text-style: italic;
    content-align: center middle;
    margin-bottom: 2;
}

.grid-section-title {
    width: 100%;
    height: 2;
    min-height: 2;
    max-height: 2;
    color: $secondary;
    text-style: bold;
    content-align: left middle;
    border-bottom: solid $border;
    padding: 0 1 1 1;
    margin-top: 1;
    margin-bottom: 1;
}

.grid-row {
    width: 100%;
    height: auto;
    layout: grid;
    grid-size: 4;
    grid-gutter: 1 2;
    margin-bottom: 1;
}

.grid-icon-btn {
    width: 100%;
    height: 15;
    background: $panel-bg;
    border: round $border;
    color: $primary;
    text-style: bold;
    content-align: center middle;
    transition: background 150ms, color 150ms, border 150ms;
}

.grid-icon-btn:hover {
    background: #1e293b;
    border: round $primary;
    color: $phover;
}

.grid-icon-btn:focus {
    background: #1e1b4b;
    border: round $phover;
    color: $phover;
    text-style: bold;
}

#grid-footer {
    width: 100%;
    height: 1;
    color: $dim;
    text-style: italic;
    content-align: center middle;
    margin-top: 2;
    border-top: solid $border;
    padding-top: 1;
}

/* ── Light theme (via App.theme-light class) ── */
App.theme-light, App.theme-light Screen {
    background: #eff1f5;
    color: #1e2030;
}
App.theme-light #header {
    background: #e6e9ef;
    border-bottom: solid #4f46e5;
}
App.theme-light #header-info { color: #1e2030; }
App.theme-light .header-logo { color: #4f46e5; }
App.theme-light .header-selector-label { color: #7a8999; }
App.theme-light #processing { background: #4f46e5; color: #eff1f5; }
App.theme-light #processing.thinking { background: #0891b2; }
App.theme-light #chat-log { background: #eff1f5; }
App.theme-light #view-panel { background: #e6e9ef; border-left: solid #ccd0da; }
App.theme-light #view-panel #view-title { background: #eff1f5; border-bottom: solid #ccd0da; color: #b56800; }
App.theme-light #input-container { background: #e6e9ef; border-top: solid #4f46e5; }
App.theme-light #input { background: rgba(0, 0, 0, 0.04); color: #1e2030; }
App.theme-light #status { background: #e6e9ef; border-top: solid #ccd0da; color: #7a8999; }
App.theme-light #view-panel #view-list Button { background: #e6e9ef; color: #1e2030; border: solid #ccd0da; }
App.theme-light #view-panel #view-list Button:hover { background: #dce0e8; color: #4f46e5; border: solid #4f46e5; }
App.theme-light #view-panel #view-back { background: #e6e9ef; border: solid #ccd0da; color: #7a8999; }
App.theme-light #toast { background: #dce0e8; border-top: solid #4f46e5; color: #1e2030; }
App.theme-light Button { color: #4c4f69; }
App.theme-light Input { background: #eff1f5; color: #1e2030; border: solid #ccd0da; }
App.theme-light Select { background: #eff1f5; color: #1e2030; border: solid #ccd0da; }
App.theme-light .grid-icon-btn { background: #e6e9ef; border: round #ccd0da; color: #4f46e5; }
App.theme-light .grid-icon-btn:hover { background: #dce0e8; border: round #4f46e5; color: #6366f1; }
App.theme-light .sess-btn { border: solid #ccd0da; }
App.theme-light .sess-btn:hover { background: #dce0e8; border: solid #4f46e5; color: #6366f1; }
/* Light theme animations are managed via Python in Textual */
